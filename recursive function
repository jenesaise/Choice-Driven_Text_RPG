def box_open(boxstring):
    if ">" not in boxstring:
        return boxstring
    else:
        splitpos = boxstring.find(">")
        return box_open(boxstring[splitpos+2:])       #+2 to account for the space after >

#example:
instring = "outerbox > innerbox > innermostbox > BOUNTY"
print(box_open(instring))
