def get_valid_user_input(current_scene, user_input, choicelist): #current_scene is a scene from the story map
    available_choices = []
    for key in current_scene:
        if key.startswith("choice"):
            available_choices.append(key)
    while True:
        if user_input.isdigit():
            if user_input >= 1 and user_input <= 3:
                return available_choices[user_input - 1], user_input #returns the key of the dictionary
            else:
                print("Invalid choice! Please select an available option.")
                user_input = input("Enter your choice: ")
        else:
            print("Invalid input! Please enter a number.")
            user_input = input("Enter your choice: ")



