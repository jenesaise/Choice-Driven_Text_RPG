def get_valid_user_input(current_scene, user_input): #current_scene is a scene from the story map
    available_choices = []
    for key in current_scene:
        if key.startswith("choice"):
            available_choices.append(key)
    while True:
        if user_input.isdigit():
            choice_number = float(user_input)
            if choice_number >= 1 and choice_number <= 4: #checking for choices up to 3.3.3.3 cause thats the max choice we have
                return available_choices[choice_number - 1] #returns the key of the dictionary
            else:
                print("Invalid choice! Please select an available option.")
                user_input = input("Enter your choice: ")
        else:
            print("Invalid input! Please enter a number.")
            user_input = input("Enter your choice: ")



